# Non-secret settings for the submitLead function (committed on purpose).
# The SMTP password is NOT here: it is the Secret Manager secret SMTP_PASS,
# set with `npx firebase-tools functions:secrets:set SMTP_PASS`.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@aeseller.com
LEAD_TO=contact@aeseller.com
ALLOWED_ORIGINS=https://aeseller.com,https://ae-seler.web.app,https://ae-seler.firebaseapp.com
