{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/about-us", "destination": "/about", "statusCode": 301 },
    { "source": "/contact-2", "destination": "/contact", "statusCode": 301 },
    { "source": "/privacy-policy", "destination": "/privacy", "statusCode": 301 },
    { "source": "/privacy-policy-2", "destination": "/privacy", "statusCode": 301 },
    { "source": "/terms-and-conditions", "destination": "/terms", "statusCode": 301 },
    { "source": "/blog", "destination": "/insights", "statusCode": 301 },
    { "source": "/brand/ae-seller", "destination": "/about", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|svg|ico)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000" }]
    },
    {
      "source": "/checkout",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
