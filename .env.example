# Copy this file to .env and fill in your own keys to enable live checkout.
# Never commit your real .env file — it should stay out of version control.

# Stripe — get your test publishable key from https://dashboard.stripe.com/test/apikeys
# (starts with pk_test_... while testing, pk_live_... in production)
VITE_STRIPE_PUBLISHABLE_KEY=

# PayPal — get your sandbox Client ID from https://developer.paypal.com/dashboard/applications/sandbox
VITE_PAYPAL_CLIENT_ID=

# IMPORTANT: This is a static frontend app with no backend. Tokenizing a card
# (Stripe createPaymentMethod) and capturing a PayPal order both work client-side
# with just the keys above. But to actually settle a Stripe charge securely, you
# need a server endpoint that creates + confirms a PaymentIntent using your
# Stripe SECRET key (never expose that key in the frontend). See the TODO comment
# in src/components/StripeCardForm.jsx for where that call belongs.

# Google Analytics 4 Measurement ID (optional). Leave empty to disable analytics entirely.
VITE_GA_MEASUREMENT_ID=
