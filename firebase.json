{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      { "source": "/about-us", "destination": "/about", "type": 301 },
      { "source": "/contact-2", "destination": "/contact", "type": 301 },
      { "source": "/privacy-policy", "destination": "/privacy", "type": 301 },
      { "source": "/privacy-policy-2", "destination": "/privacy", "type": 301 },
      { "source": "/terms-and-conditions", "destination": "/terms", "type": 301 },
      { "source": "/blog", "destination": "/insights", "type": 301 },
      { "source": "/brand/ae-seller", "destination": "/about", "type": 301 }
    ],
    "headers": [
      {
        "source": "**/*.@(webp|png|jpg|jpeg|svg|ico)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/fonts/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000" }]
      },
      {
        "source": "/checkout",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
      }
    ],
    "rewrites": [
      {
        "source": "/api/lead",
        "function": {
          "functionId": "submitLead",
          "region": "us-central1"
        }
      }
    ]
  }
}
